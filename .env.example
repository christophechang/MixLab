CHANGSTA_API_KEY=
CATALOG_API_URL=  # optional — omit to use full collection without played-track filtering
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
MIXLAB_DISCORD_CHANNEL=mix-lab
MIXLAB_DISCORD_CHANNEL_ID=
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
MIXLAB_STAGE2_MODEL=  # override the Stage 2 Anthropic model id (default: claude-sonnet-4-6)
MIXLAB_STAGE2_TEMPERATURE=  # override the Stage 2 selection-pass temperature (default: 0.5)
MIXLAB_DIAGNOSTICS_DIR=  # where max_tokens-truncated LLM responses are dumped for post-mortem (default: .mixlab/diagnostics)
MIXLAB_API_URL=  # MixLab Anywhere API base URL (required for --worker / --worker-once)
MIXLAB_API_SECRET=  # MixLab Anywhere shared bearer secret (required for --worker / --worker-once)
MIXLAB_WORKER_POLL_SECONDS=  # worker empty-poll cadence in seconds (default: 30)
MIXLAB_WORKER_XML_PATH=  # where the worker writes the downloaded collection (default: .mixlab/worker-collection.xml — kept off import/rekordbox.xml so remote runs never clobber a local collection)
MIXLAB_WORKER_RUN_TIMEOUT=  # hard per-run subprocess timeout in seconds (default: 1200)
