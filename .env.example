CHANGSTA_API_KEY=
CATALOG_API_URL=  # optional — omit to use full collection without played-track filtering
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
MIXLAB_DISCORD_CHANNEL=mix-lab
MIXLAB_DISCORD_CHANNEL_ID=
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
MIXLAB_STAGE2_MODEL=  # override the Stage 2 Anthropic model id (default: claude-sonnet-4-6; claude-sonnet-5-5 supported)
MIXLAB_STAGE2_TEMPERATURE=  # override the Stage 2 selection-pass temperature (default: 0.5; ignored on claude-sonnet-5-5)
# MIXLAB_KEY_NOTATION=camelot  # camelot (default): Tonality copied as written; any: classical spellings normalised to Camelot codes
# MIXLAB_PLAYED_SOURCE=catalog  # catalog (default): played status from the catalogue when CATALOG_API_URL is set; file: played means PlayCount >= 1 in the export
# MIXLAB_API_MODE=tenant  # tenant: token budget, 480 s attempt bound with one retry, typed provider errors and exit codes 2-6; unset: unchanged
# MIXLAB_TOKEN_BUDGET=150000,56000  # <input>,<output> token allowances (tenant mode only; malformed warns and uses this default)
# MIXLAB_STAGE2_EFFORT=high  # low|medium|high: effort and thinking per call on a 5-family model id; unset or invalid: today's payload
# MIXLAB_FALLBACKS=default  # default: Stage 2 calls request Anthropic's server-side fallback (never Stage 0)
# MIXLAB_STAGE0_MODEL=  # an Anthropic model id for the Stage 0 intent brief instead of the free cascade (60 s, no retry)
# MIXLAB_LLM_STUB=1  # 1: no LLM request and no API key needed; deterministic selection and reports, every artifact written
MIXLAB_DIAGNOSTICS_DIR=  # where max_tokens-truncated LLM responses are dumped for post-mortem (default: .mixlab/diagnostics)
MIXLAB_API_URL=  # MixLab Anywhere API base URL (required for --worker / --worker-once)
MIXLAB_API_SECRET=  # MixLab Anywhere shared bearer secret (required for --worker / --worker-once)
MIXLAB_WORKER_POLL_SECONDS=  # worker empty-poll cadence in seconds (default: 30)
MIXLAB_WORKER_XML_PATH=  # where the worker writes the downloaded collection (default: .mixlab/worker-collection.xml — kept off import/rekordbox.xml so remote runs never clobber a local collection)
MIXLAB_WORKER_RUN_TIMEOUT=  # hard per-run subprocess timeout in seconds (default: 1200)
